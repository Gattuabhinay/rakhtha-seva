# Supabase (required for real login + case history)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — AI match brief + WhatsApp text (server-only)
OPENROUTER_API_KEY=

# ElevenLabs — speak AI brief aloud (server-only)
# MVP languages: English + Hindi. Telugu needs Eleven v3 Conversational later.
ELEVENLABS_API_KEY=
# Optional — default Multilingual v2 (same as ElevenLabs Speech UI)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# REQUIRED on free plan: your OWN voice ID (Voice Design / Instant Clone).
# Premade library voices (Rachel etc.) return 402 on free API.
# ELEVENLABS_VOICE_ID=

# Twilio — automated outbound voice blast
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Twilio OTP SMS (can be same account as voice for demo)
TWILIO_OTP_ACCOUNT_SID=
TWILIO_OTP_AUTH_TOKEN=
TWILIO_OTP_FROM_NUMBER=
# Optional — Twilio Verify service SID (auto-created as "Rakhtha Seva OTP" if omitted)
# TWILIO_VERIFY_SERVICE_SID=VA...

# Optional — Fast2SMS for OTP SMS to any Indian number (Twilio trial cannot do this)
# FAST2SMS_API_KEY=

# Resend — email match summary to requester
RESEND_API_KEY=
# Optional verified sender (default uses Resend onboarding from)
# RESEND_FROM=Rakhtha Seva <onboarding@resend.dev>

# Optional alternate AI fallbacks
OPENAI_API_KEY=
GEMINI_API_KEY=
